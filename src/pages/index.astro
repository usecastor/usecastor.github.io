---
// Castor V3 — Flagship single-author homepage.
// Four cinematic acts, each an isolated React 19 island:
//   ACT 1  HeroCinema       (client:load — LCP above-the-fold)
//   ACT 2  DualEngineBeam   (client:visible)
//   ACT 3  SavingsInstrument(client:visible)
//   ACT 4  DeployDeck       (client:visible)
// plus the sleek dark-glass Header and minimal obsidian Footer.
//
// Total visible prose is ruthlessly terse (< 320 words) — every number is
// sourced from the 100%-verified November 19, 2026 telemetry layer.

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeroCinema from '../components/v3/HeroCinema';
import DualEngineBeam from '../components/v3/DualEngineBeam';
import SavingsInstrument from '../components/v3/SavingsInstrument';
import DeployDeck from '../components/v3/DeployDeck';
import { getPrecompiledHeroSteps } from '../data/magic-move-steps';

// Build-time precompiled magic-move tokens (inlined as plain JSON — zero
// Shiki JS/WASM shipped; the browser only plays CSS token morphs).
const steps = await getPrecompiledHeroSteps();
---

<Layout
  title="Castor — Keep Your Frontier Model. Stop Paying It to Read Files."
  description="Run autonomous AI coding agents on your private GPU: 2.62B tokens over 76 days at 93.7% prefix-cache hit, 99.84% net savings versus cloud API counterfactual."
>
  <Header />
  <main id="main-content">
    <HeroCinema client:load steps={steps} />
    <DualEngineBeam client:visible />
    <SavingsInstrument client:visible />
    <DeployDeck client:visible />
  </main>
  <Footer />
</Layout>
