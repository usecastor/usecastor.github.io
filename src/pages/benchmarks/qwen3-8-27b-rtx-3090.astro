---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import QuickstartFooter from '../../components/QuickstartFooter.astro';
import {
  LEDGER_76DAY as L,
  HARDWARE_SNAPSHOT as H,
  VRAM_TIERS,
  QWEN38_BENCHMARKS,
  QWEN38_MODEL_CARD_DATE,
  QWEN38_LICENSE,
} from '../../data/telemetry';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteUrl = new URL(Astro.site ?? 'http://localhost').href.replace(/\/$/, '');
const root = `${siteUrl}${base}/`;

const breadcrumb = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: root },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Benchmarks',
      item: `${root}benchmarks/`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: 'Qwen3.8-27B on RTX 3090',
    },
  ],
};

const techArticle = {
  '@type': 'TechArticle',
  name: 'Qwen3.8-27B on RTX 3090 — 78-Day Castor Telemetry',
  datePublished: '2026-09-04',
  dateModified: '2026-11-21',
  author: { '@type': 'Organization', name: 'Castor Technologies' },
  publisher: { '@type': 'Organization', name: 'Castor Technologies' },
  mainEntityOfPage: `${root}benchmarks/qwen3-8-27b-rtx-3090/`,
  wordCount: 1100,
  keywords:
    'Qwen3.8-27B, RTX 3090, vLLM, MTP speculative decode, tok/s prefill, KV cache, W4A16, llama.cpp, DFlash2, local LLM benchmark, air-gapped',
  abstract:
    'A 78-day production ledger (Sep 4 – Nov 21, 2026) of Qwen3.8-27B-W4A16 served by vLLM 0.33.0 on a single RTX 3090: 2.77B tokens, 93.8% session KV-cache hit, 3,247 tok/s effective prefill, 70.4 tok/s sustained decode, $10.12 in electricity vs. a $6,044.48 cloud counterfactual ($6,034.36 net saved).',
};

const jsonLd = [breadcrumb, techArticle];
---

<Layout
  title="Qwen3.8-27B on RTX 3090 Benchmarks — 78-Day Castor Telemetry"
  description="Complete measured 78-day ledger (Sep 4 – Nov 21, 2026) of Qwen3.8-27B-W4A16 on a single RTX 3090 under vLLM 0.33.0: 2.77B tokens, 93.8% session KV-cache hit, 3,247 tok/s effective prefill, 70.4 tok/s sustained decode, 260 tok/s aggregate across n=4 concurrent streams — $10.12 power vs. a $6,044.48 cloud counterfactual ($6,034.36 net saved). VRAM tier matrix from 8 GB to 24 GB+ included."
  canonicalPath="/benchmarks/qwen3-8-27b-rtx-3090/"
  jsonLd={jsonLd}
>
  <Header />
  <main id="main-content" class="min-h-screen bg-ground">
    <!-- ── Page hero ──────────────────────────────────────────────────── -->
    <section class="hardware-dot-grid">
      <div class="mx-auto max-w-6xl px-4 pb-10 pt-10 sm:px-6 lg:px-8">
        <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-local">
          // benchmarks · qwen3.8-27b · single rtx 3090 · vllm 0.33.0
        </p>
        <h1
          class="mt-4 font-display text-[clamp(1.9rem,3.4vw,3rem)] font-bold leading-[1.02] tracking-[-0.035em] text-ink"
        >
          Qwen3.8-27B on a Single RTX 3090 —
          <span class="text-local">78 Days of Measured Telemetry.</span>
        </h1>
        <p class="mt-4 max-w-2xl font-sans text-[15px] leading-relaxed text-ink-secondary sm:text-base">
          A <code class="am-code">castor stats</code> ledger captured every
          turn over <b>78 days (Sep 4 – Nov 21, 2026)</b> on one RTX 3090
          running <code class="am-code">Qwen3.8-27B-W4A16-AutoRound-fast</code>
          under vLLM 0.33.0 with MTP speculative decoding — 2.77 billion
          tokens, with <b>93.8% of the {L.promptTokensDisplay} prompt tokens
          served from VRAM via multi-turn session KV-cache reuse</b>, and
          <b>$10.12 of electricity</b> against a
          <b>$6,044.48 cloud-API counterfactual</b> ($6,034.36 net saved).
        </p>

        <!-- 4-cell hero ledger strip -->
        <div class="spec-grid mt-8 grid grid-cols-2 lg:grid-cols-4">
          <div class="p-4">
            <p class="font-mono text-[10px] uppercase tracking-widest text-ink-muted">Total tokens</p>
            <p class="tabular mt-1 font-display text-2xl font-bold text-ink md:text-3xl">
              2.77B
            </p>
            <p class="mt-0.5 font-mono text-[11px] text-ink-secondary">
              {L.totalTokens.toLocaleString('en-US')} over {L.days} days
            </p>
          </div>
          <div class="p-4">
            <p class="font-mono text-[10px] uppercase tracking-widest text-ink-muted">KV cache hit</p>
            <p class="tabular mt-1 font-display text-2xl font-bold text-cloud md:text-3xl">
              93.8%
            </p>
            <p class="mt-0.5 font-mono text-[11px] text-ink-secondary">
              {L.cachedTokensDisplay} / {L.promptTokensDisplay} · session reuse
            </p>
          </div>
          <div class="p-4">
            <p class="font-mono text-[10px] uppercase tracking-widest text-ink-muted">Prefill (effective)</p>
            <p class="tabular mt-1 font-display text-2xl font-bold text-ink md:text-3xl">
              {L.effectivePrefillTps.toLocaleString('en-US')}
            </p>
            <p class="mt-0.5 font-mono text-[11px] text-ink-secondary">
              tok/s effective prefill (warm + cold)
            </p>
          </div>
          <div class="p-4">
            <p class="font-mono text-[10px] uppercase tracking-widest text-ink-muted">Net savings</p>
            <p class="tabular mt-1 font-display text-2xl font-bold text-ok md:text-3xl">
              {L.netSavingsPct}%
            </p>
            <p class="mt-0.5 font-mono text-[11px] text-ink-secondary">
              ${L.electricityUsd} power vs. ${L.cloudCounterfactualUsd.toLocaleString('en-US')} cf
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Section: 78-day ledger ─────────────────────────────────────── -->
    <section id="ledger" class="scroll-mt-16 border-y border-hairline bg-recessed/40">
      <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
        <header>
          <div class="folio-bar">
            <span class="folio-coord">
              the 78-day ledger · <code class="am-code">castor stats</code>
            </span>
            <span class="folio-index">01 / 05</span>
          </div>
          <h2 class="mt-2 font-display text-2xl font-bold tracking-tight text-ink md:text-3xl">
            The Complete Measured Ledger
          </h2>
          <p class="mt-3 max-w-2xl font-sans text-sm leading-relaxed text-ink-secondary">
            Every figure below is a direct output of
            <code class="am-code">castor stats</code> aggregated over the
            {L.windowStart} → {L.windowEnd} window.
          </p>
        </header>

        <div class="spec-grid mt-8 grid grid-cols-2 lg:grid-cols-4">
          <div class="p-4">
            <p class="font-mono text-[10px] uppercase tracking-widest text-ink-muted">Window</p>
            <p class="mt-1 font-mono text-sm text-ink">{L.days} days</p>
            <p class="mt-0.5 font-mono text-[11px] text-ink-secondary">{L.windowStart} → {L.windowEnd}</p>
          </div>
          <div class="p-4">
            <p class="font-mono text-[10px] uppercase tracking-widest text-ink-muted">Prompt tokens</p>
            <p class="tabular mt-1 font-mono text-lg font-semibold text-ink">
              {L.promptTokens.toLocaleString('en-US')}
            </p>
            <p class="mt-0.5 font-mono text-[11px] text-ink-secondary">{L.promptTokensDisplay}</p>
          </div>
          <div class="p-4">
            <p class="font-mono text-[10px] uppercase tracking-widest text-ink-muted">Session-cached tokens</p>
            <p class="tabular mt-1 font-mono text-lg font-semibold text-ink">
              {L.cachedTokens.toLocaleString('en-US')}
            </p>
            <p class="mt-0.5 font-mono text-[11px] text-ink-secondary">{L.cachedTokensDisplay} · {L.cacheHitPct}% of prompt</p>
          </div>
          <div class="p-4">
            <p class="font-mono text-[10px] uppercase tracking-widest text-ink-muted">Completion tokens</p>
            <p class="tabular mt-1 font-mono text-lg font-semibold text-ink">
              {L.completionTokens.toLocaleString('en-US')}
            </p>
            <p class="mt-0.5 font-mono text-[11px] text-ink-secondary">{L.completionTokensDisplay}</p>
          </div>
          <div class="p-4">
            <p class="font-mono text-[10px] uppercase tracking-widest text-ink-muted">Reasoning tokens</p>
            <p class="tabular mt-1 font-mono text-lg font-semibold text-ink">
              {L.reasoningTokens.toLocaleString('en-US')}
            </p>
            <p class="mt-0.5 font-mono text-[11px] text-ink-secondary">{L.reasoningTokensDisplay} · {L.reasoningSharePct}% of completion</p>
          </div>
          <div class="p-4">
            <p class="font-mono text-[10px] uppercase tracking-widest text-ink-muted">Autonomous turns</p>
            <p class="tabular mt-1 font-mono text-lg font-semibold text-ink">
              {L.turns.toLocaleString('en-US')}
            </p>
            <p class="mt-0.5 font-mono text-[11px] text-ink-secondary">
              {L.sessions.toLocaleString('en-US')} sessions · {L.tasks} tasks
            </p>
          </div>
          <div class="p-4">
            <p class="font-mono text-[10px] uppercase tracking-widest text-ink-muted">Sandboxed tool calls</p>
            <p class="tabular mt-1 font-mono text-lg font-semibold text-ink">
              {L.toolCalls.toLocaleString('en-US')}
            </p>
            <p class="mt-0.5 font-mono text-[11px] text-ink-secondary">{L.toolSuccessPct}% success</p>
          </div>
          <div class="p-4">
            <p class="font-mono text-[10px] uppercase tracking-widest text-ink-muted">Surgical edit ratio</p>
            <p class="tabular mt-1 font-mono text-lg font-semibold text-ink">{L.surgicalEditRatio}×</p>
            <p class="mt-0.5 font-mono text-[11px] text-ink-secondary">{L.surgicalEditDetail}</p>
          </div>
          <div class="p-4">
            <p class="font-mono text-[10px] uppercase tracking-widest text-ink-muted">Sustained decode</p>
            <p class="tabular mt-1 font-mono text-lg font-semibold text-ink">{L.sustainedDecodeTps} tok/s</p>
            <p class="mt-0.5 font-mono text-[11px] text-ink-secondary">{L.days}-day mean</p>
          </div>
          <div class="p-4">
            <p class="font-mono text-[10px] uppercase tracking-widest text-ink-muted">Concurrent decode</p>
            <p class="tabular mt-1 font-mono text-lg font-semibold text-ink">
              {L.concurrentN4DecodeTps} tok/s
            </p>
            <p class="mt-0.5 font-mono text-[11px] text-ink-secondary">
              aggregate across n=4 concurrent · warm KV prefix
            </p>
          </div>
          <div class="p-4">
            <p class="font-mono text-[10px] uppercase tracking-widest text-ink-muted">Effective prefill</p>
            <p class="tabular mt-1 font-mono text-lg font-semibold text-ink">
              {L.effectivePrefillTps.toLocaleString('en-US')} tok/s
            </p>
            <p class="mt-0.5 font-mono text-[11px] text-ink-secondary">effective prefill (warm + cold)</p>
          </div>
          <div class="p-4">
            <p class="font-mono text-[10px] uppercase tracking-widest text-ink-muted">GPU compute time</p>
            <p class="tabular mt-1 font-mono text-lg font-semibold text-ink">{L.gpuComputeDisplay}</p>
            <p class="mt-0.5 font-mono text-[11px] text-ink-secondary">{L.sessionWallClock} session wall-clock</p>
          </div>
          <div class="p-4">
            <p class="font-mono text-[10px] uppercase tracking-widest text-ink-muted">Electricity cost</p>
            <p class="tabular mt-1 font-mono text-lg font-semibold text-ink">${L.electricityUsd}</p>
            <p class="mt-0.5 font-mono text-[11px] text-ink-secondary">
              {L.electricityKwh} kWh @ ${L.electricityRateUsdPerKwh}/kWh · 262.5 W locked limit (350 W stock)
            </p>
          </div>
          <div class="p-4">
            <p class="font-mono text-[10px] uppercase tracking-widest text-ink-muted">Cloud counterfactual</p>
            <p class="tabular mt-1 font-mono text-lg font-semibold text-block">
              ${L.cloudCounterfactualUsd.toLocaleString('en-US', { minimumFractionDigits: 2 })}
            </p>
            <p class="mt-0.5 font-mono text-[11px] text-ink-secondary">Sonnet-tier $2/$10 API pricing</p>
          </div>
          <div class="sm:col-span-2 lg:col-span-4 p-4">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-baseline sm:justify-between">
              <div class="flex items-baseline gap-3">
                <p class="font-mono text-[10px] uppercase tracking-widest text-ink-muted">Net savings</p>
                <p class="tabular font-mono text-lg font-semibold text-ok">
                  ${L.netSavingsUsd.toLocaleString('en-US', { minimumFractionDigits: 2 })}
                </p>
                <p class="font-mono text-[11px] text-ink-secondary">{L.netSavingsPct}% of cloud cost</p>
              </div>
              <p class="font-mono text-[11px] text-ink-secondary">
                ${L.electricityUsd} electricity ({L.electricityKwh} kWh) vs. ${L.cloudCounterfactualUsd.toLocaleString('en-US', { minimumFractionDigits: 2 })} Sonnet-tier counterfactual — full 78-day window
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Section: live vLLM / nvidia-smi snapshot ──────────────────── -->
    <section id="live" class="scroll-mt-16 border-b border-hairline">
      <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
        <header>
          <div class="folio-bar">
            <span class="folio-coord">
              hardware snapshot · {H.asOf}
            </span>
            <span class="folio-index">02 / 05</span>
          </div>
          <h2 class="mt-2 font-display text-2xl font-bold tracking-tight text-ink md:text-3xl">
            vLLM 0.33.0 <code class="am-code">/metrics</code> &amp;
            <code class="am-code">nvidia-smi</code>
          </h2>
          <p class="mt-3 max-w-2xl font-sans text-sm leading-relaxed text-ink-secondary">
            Single-day vLLM <code class="am-code">/metrics</code> snapshot
            (2026-11-21): <code class="am-code">70.5%</code> MTP draft
            acceptance with a <code class="am-code">3.45</code> mean acceptance
            length, alongside the serving stack's
            <code class="am-code">nvidia-smi</code> readings from the same day.
          </p>
        </header>

        <div class="mt-8 grid gap-px lg:grid-cols-12">
          <!-- Left: nvidia-smi hardware -->
          <div class="instrument-chassis lg:col-span-5">
            <div
              class="flex items-center justify-between border-b border-[var(--bg-instrument-border)] bg-[var(--bg-instrument-raised)] px-4 py-2"
            >
              <span class="font-mono text-[11px] uppercase tracking-widest text-ink-instrument-muted">
                nvidia-smi · snapshot
              </span>
              <span class="font-mono text-[10px] text-ink-instrument-muted">{H.asOf}</span>
            </div>
            <div class="p-5">
              <dl class="space-y-3">
                <div class="flex items-baseline justify-between border-b border-[var(--bg-instrument-border)] pb-2">
                  <dt class="font-mono text-[11px] uppercase tracking-widest text-ink-instrument-muted">GPU</dt>
                  <dd class="font-mono text-xs text-ink-instrument">{H.gpu.model}</dd>
                </div>
                <div class="flex items-baseline justify-between border-b border-[var(--bg-instrument-border)] pb-2">
                  <dt class="font-mono text-[11px] uppercase tracking-widest text-ink-instrument-muted">VRAM used</dt>
                  <dd class="tabular font-mono text-xs text-ink-instrument">
                    {H.gpu.vramUsedMiB.toLocaleString('en-US')} / {H.gpu.vramTotalMiB.toLocaleString('en-US')} MiB
                  </dd>
                </div>
                <div class="flex items-baseline justify-between border-b border-[var(--bg-instrument-border)] pb-2">
                  <dt class="font-mono text-[11px] uppercase tracking-widest text-ink-instrument-muted">Power draw</dt>
                  <dd class="tabular font-mono text-xs text-ink-instrument">
                    {H.gpu.powerDrawW} W / {H.gpu.powerLimitW} W limit
                  </dd>
                </div>
                <div class="flex items-baseline justify-between border-b border-[var(--bg-instrument-border)] pb-2">
                  <dt class="font-mono text-[11px] uppercase tracking-widest text-ink-instrument-muted">Temperature</dt>
                  <dd class="tabular font-mono text-xs text-ink-instrument">{H.gpu.tempC} °C</dd>
                </div>
                <div class="flex items-baseline justify-between">
                  <dt class="font-mono text-[11px] uppercase tracking-widest text-ink-instrument-muted">Driver</dt>
                  <dd class="tabular font-mono text-xs text-ink-instrument">{H.gpu.driver}</dd>
                </div>
              </dl>
            </div>
          </div>

          <!-- Right: vLLM engine -->
          <div class="instrument-chassis mt-4 lg:mt-0 lg:col-span-7">
            <div
              class="flex items-center justify-between border-b border-[var(--bg-instrument-border)] bg-[var(--bg-instrument-raised)] px-4 py-2"
            >
              <span class="font-mono text-[11px] uppercase tracking-widest text-ink-instrument-muted">
                {H.engine.name} · GET /metrics
              </span>
              <span class="font-mono text-[10px] text-ink-instrument-muted">{H.engine.model}</span>
            </div>
            <div class="grid grid-cols-2 gap-px md:grid-cols-4">
              <div class="bg-[var(--bg-instrument)] p-4">
                <p class="font-mono text-[10px] uppercase tracking-widest text-ink-instrument-muted">Max model len</p>
                <p class="tabular mt-1 font-mono text-lg font-semibold text-ink-instrument">
                  {(H.engine.maxModelLen / 1000).toFixed(0)}K
                </p>
              </div>
              <div class="bg-[var(--bg-instrument)] p-4">
                <p class="font-mono text-[10px] uppercase tracking-widest text-ink-instrument-muted">KV cache hit</p>
                <p class="tabular mt-1 font-mono text-lg font-semibold text-local-oled">
                  {H.engine.livePrefixHitPct}%
                </p>
              </div>
              <div class="bg-[var(--bg-instrument)] p-4">
                <p class="font-mono text-[10px] uppercase tracking-widest text-ink-instrument-muted">MTP acceptance</p>
                <p class="tabular mt-1 font-mono text-lg font-semibold text-ink-instrument">
                  {H.engine.liveDraftAcceptancePct}%
                </p>
                <p class="mt-0.5 font-mono text-[10px] text-ink-instrument-muted">
                  mean accept len {H.engine.meanAcceptanceLen}
                </p>
              </div>
              <div class="bg-[var(--bg-instrument)] p-4">
                <p class="font-mono text-[10px] uppercase tracking-widest text-ink-instrument-muted">Avg TTFT</p>
                <p class="tabular mt-1 font-mono text-lg font-semibold text-ink-instrument">
                  {H.engine.liveAvgTtftS} s
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Section: VRAM tiers ────────────────────────────────────────── -->
    <section id="tiers" class="scroll-mt-16 border-b border-hairline bg-recessed/40">
      <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
        <header>
          <div class="folio-bar">
            <span class="folio-coord">vram tier matrix</span>
            <span class="folio-index">03 / 05</span>
          </div>
          <h2 class="mt-2 font-display text-2xl font-bold tracking-tight text-ink md:text-3xl">
            VRAM Tiers: Same Kernel, Different Ceiling
          </h2>
          <p class="mt-3 max-w-2xl font-sans text-sm leading-relaxed text-ink-secondary">
            The <b>24 GB+ row is the configuration this page benchmarks</b> —
            vLLM 0.33.0 with Qwen3.8-27B-W4A16-AutoRound-fast and MTP
            speculative decode against a 150K KV pool. Smaller VRAM tiers run
            smaller (7B–14B) or more aggressively quantized models, not the full
            27B W4A16 build.
          </p>
        </header>

        <div class="mt-8 overflow-x-auto">
          <table class="w-full min-w-[640px] border-collapse">
            <thead>
              <tr class="border-b border-hairline">
                <th class="py-2 pr-4 text-left font-mono text-[11px] uppercase tracking-widest text-ink-muted">VRAM</th>
                <th class="py-2 pr-4 text-left font-mono text-[11px] uppercase tracking-widest text-ink-muted">Engine profile</th>
                <th class="py-2 pr-4 text-left font-mono text-[11px] uppercase tracking-widest text-ink-muted">Context</th>
                <th class="py-2 text-left font-mono text-[11px] uppercase tracking-widest text-ink-muted">Decode throughput</th>
              </tr>
            </thead>
            <tbody>
              {VRAM_TIERS.map((t) => (
                <tr
                  class={`border-b border-hairline ${t.highlight ? 'bg-surface' : ''}`}
                >
                  <td class="py-3 pr-4 font-mono text-xs text-ink">
                    {t.highlight && (
                      <span class="mr-1.5 inline-block h-1.5 w-1.5 rounded-full bg-local align-middle" aria-hidden="true"></span>
                    )}
                    {t.vram}
                  </td>
                  <td class="py-3 pr-4 font-mono text-xs text-ink-secondary">{t.engine}</td>
                  <td class="py-3 pr-4 font-mono text-xs text-ink-secondary">{t.context}</td>
                  <td class="py-3 font-mono text-xs text-ink-secondary">{t.decode}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ── Section: Qwen3.8-27B vendor scores ────────────────────────── -->
    <section id="model" class="scroll-mt-16 border-b border-hairline">
      <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
        <header>
          <div class="folio-bar">
            <span class="folio-coord">
              model card · {QWEN38_MODEL_CARD_DATE} · {QWEN38_LICENSE}
            </span>
            <span class="folio-index">04 / 05</span>
          </div>
          <h2 class="mt-2 font-display text-2xl font-bold tracking-tight text-ink md:text-3xl">
            Qwen3.8-27B — Vendor-Published Benchmark Scores
          </h2>
          <p class="mt-3 max-w-2xl font-sans text-sm leading-relaxed text-ink-secondary">
            The model card (released {QWEN38_MODEL_CARD_DATE},
            <b>{QWEN38_LICENSE}</b> license) publishes the scores below.
            Castor serves the <code class="am-code">W4A16-AutoRound-fast</code>
            quantization — ~¼ the weight footprint of BF16 (~14 GB vs. ~54 GB
            BF16) on this 24 GB GPU.
          </p>
        </header>

        <div class="spec-grid mt-8 grid grid-cols-2 lg:grid-cols-4">
          {QWEN38_BENCHMARKS.map((b) => (
            <div class="p-5">
