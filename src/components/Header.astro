---
// Castor V3 — Ultra-clean floating obsidian glass bar.
// 56px (h-14) sticky bar: dark glass that blends into the GPU-shader hero AND
// reads as a crisp hardware bar over the ivory acts and the SEO subpages.
//
// Nav anchors are base-prefixed (`${base}/#how-it-works`) so they resolve to
// the homepage sections from any subpage (Vercel '/' and GitHub Pages '/Castor').
// 100% real data: install command + repo link from the verified telemetry layer.

const GITHUB_URL = 'https://github.com/usecastor/castor';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const NAV_LINKS: Array<{ id: string; label: string; href: string }> = [
  { id: 'how-it-works', label: 'Two Wings', href: `${base}/#how-it-works` },
  { id: 'savings', label: 'Calculator', href: `${base}/#savings` },
  { id: 'deploy', label: 'Setup & Plumbing', href: `${base}/#deploy` },
  {
    id: 'benchmarks',
    label: '78-Day Benchmarks',
    href: `${base}/benchmarks/qwen3-8-27b-rtx-3090/`,
  },
  {
    id: 'airgap',
    label: 'Air-Gap & Security',
    href: `${base}/enterprise/air-gapped-coding-agent/`,
  },
];
---

<header
  class="sticky top-0 z-50 border-b border-white/10 bg-[#06080D]/85 text-[#F3F5F8] backdrop-blur-xl"
>
  <div class="relative mx-auto flex h-14 max-w-[1360px] items-center gap-4 px-4 sm:px-6 lg:px-8">
    <!-- Pure CSS scroll progress: 2px molten amber, flush on the bottom edge
         (animation-timeline: scroll — zero JS, GPU-only transform). -->
    <div class="scroll-progress" aria-hidden="true"></div>

    <!-- Brand -->
    <a href={base || '/'} class="flex min-w-0 shrink-0 items-center gap-2.5" aria-label="Castor Technologies home">
      <img
        src={`${base}/assets/logo.svg`}
        alt=""
        width="26"
        height="26"
        class="h-[26px] w-[26px]"
        loading="eager"
        decoding="async"
      />
      <span class="flex flex-col leading-none">
        <span class="font-display text-[15px] font-bold leading-none tracking-[0.02em] text-[#F5F7FA]"
          >CASTOR</span
        >
        <span class="mt-0.5 hidden font-mono text-[9px] uppercase tracking-[0.14em] text-[#7FA6FF] xl:block"
          >Hybrid &amp; Local GPU Agents</span
        >
      </span>
    </a>

    <!-- Center nav (md+): exactly five clean links. -->
    <nav aria-label="Primary" class="ml-auto hidden items-center gap-1 md:flex">
      {NAV_LINKS.map((link) => (
        <a
          href={link.href}
          class="rounded-md px-2.5 py-2.5 font-mono text-[12px] tracking-[0.01em] text-[#AEB8C9] transition-colors duration-150 hover:bg-white/5 hover:text-[#F5F7FA]"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Right cluster -->
    <div class="ml-auto flex items-center gap-2 md:ml-0">
      <!-- Machined 1px amber hairline install copier (de-duplicated: the Hero
           owns the homepage's single solid-amber `bg-[#F97316]` button; both
           the bar and drawer install buttons stay outline so nothing competes). -->
      <button
        type="button"
        id="header-install"
        aria-label="Copy install command"
        class="inline-flex h-9 min-w-[92px] items-center justify-center rounded-md border border-[#F97316]/60 bg-[#F97316]/10 px-4 font-mono text-[12.5px] font-semibold tracking-[0.01em] text-[#FB923C] transition-colors duration-150 hover:bg-[#F97316] hover:text-[#05070B]"
      >
        <span data-copy-label>Install</span>
        <span data-copy-done class="whitespace-nowrap" style="display: none;">Copied ✓</span>
      </button>

      <!-- Compact CTO/manager action: straight to the setup & plumbing deck. -->
      <a
        href={`${base}/#deploy`}
        class="hidden items-center font-mono text-[12.5px] tracking-[0.01em] text-[#AEB8C9] transition-colors duration-150 hover:text-[#F5F7FA] lg:inline-flex"
      >
        Book Setup →
      </a>

      <!-- GitHub -->
      <a
        href={GITHUB_URL}
        target="_blank"
        rel="noreferrer"
        aria-label="Castor on GitHub"
        class="flex h-10 w-10 items-center justify-center rounded-lg text-[#AEB8C9] transition-colors duration-150 hover:bg-white/5 hover:text-[#F5F7FA]"
      >
        <svg width="17" height="17" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.89.87 2.36.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
          />
        </svg>
      </a>

      <!-- Mobile hamburger (visible < 768px) -->
      <button
        type="button"
        id="nav-toggle"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Toggle navigation menu"
        class="flex h-10 w-10 items-center justify-center rounded-lg text-[#F3F5F8] transition-colors duration-150 hover:bg-white/5 md:hidden"
      >
        <svg
          id="nav-icon-menu"
          width="18"
          height="18"
          viewBox="0 0 18 18"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M3 5.5h12M3 9h12M3 12.5h12" />
        </svg>
        <svg
          id="nav-icon-close"
          width="18"
          height="18"
          viewBox="0 0 18 18"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          class="hidden"
          aria-hidden="true"
        >
          <path d="M5 5l8 8M13 5l-8 8" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile drawer: sleek dark glass, zero clipping, closes on Escape / link tap -->
  <div
    id="mobile-nav"
    class="relative z-50 border-t border-white/10 bg-[#06080D]/95 backdrop-blur-xl md:hidden"
    hidden
  >
    <nav aria-label="Mobile" class="flex flex-col px-2 py-2">
      {NAV_LINKS.map((link) => (
        <a
          href={link.href}
          data-close-nav
          class="rounded-lg px-4 py-3 font-mono text-[13.5px] text-[#C7D0DE] transition-colors hover:bg-white/5 hover:text-[#F5F7FA]"
        >
          {link.label}
        </a>
      ))}
      <div class="mt-2 flex items-center gap-2 border-t border-white/10 px-2 pb-1 pt-3">
        <button
          type="button"
          id="drawer-install"
          aria-label="Copy install command"
          class="inline-flex h-11 flex-1 items-center justify-center rounded-lg border border-[#F97316]/60 bg-[#F97316]/10 px-4 font-mono text-[13px] font-semibold tracking-[0.01em] text-[#FB923C] transition-colors hover:bg-[#F97316] hover:text-[#05070B]"
        >
          <span data-copy-label>Install</span>
          <span data-copy-done class="whitespace-nowrap" style="display: none;">Copied ✓</span>
        </button>
        <a
          href={GITHUB_URL}
          target="_blank"
          rel="noreferrer"
          aria-label="Castor on GitHub"
          data-close-nav
          class="flex h-11 w-11 items-center justify-center rounded-lg border border-white/15 text-[#C7D0DE] transition-colors hover:bg-white/5 hover:text-[#F5F7FA]"
        >
          <svg width="17" height="17" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.89.87 2.36.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
            />
          </svg>
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  // ── Install copiers (bar + drawer): real clipboard writes, instant feedback ─
  (() => {
    const CMD = 'npx -y mcp-castor install --client all';
    const timers: Record<string, number> = {};

    for (const btn of document.querySelectorAll<HTMLButtonElement>(
      '#header-install, #drawer-install',
    )) {
      const label = btn.querySelector<HTMLSpanElement>('[data-copy-label]');
      const done = btn.querySelector<HTMLSpanElement>('[data-copy-done]');
      if (!label || !done) continue;

      const show = (copied: boolean) => {
        label.style.display = copied ? 'none' : 'inline';
        done.style.display = copied ? 'inline' : 'none';
        btn.setAttribute('aria-label', copied ? 'Copied' : 'Copy install command');
      };

      btn.addEventListener('click', () => {
        void navigator.clipboard?.writeText(CMD).catch(() => {
          /* non-secure context — the confirmation still shows */
        });
        show(true);
        window.clearTimeout(timers[btn.id]);
        timers[btn.id] = window.setTimeout(() => show(false), 2000);
      });
    }
  })();

  // ── Mobile drawer: open / close, Escape, and close on link tap ─────────
  (() => {
    const toggle = document.getElementById('nav-toggle');
    const panel = document.getElementById('mobile-nav');
    const iconMenu = document.getElementById('nav-icon-menu');
    const iconClose = document.getElementById('nav-icon-close');
    if (!toggle || !panel) return;

    const set = (open: boolean) => {
      panel.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      iconMenu?.classList.toggle('hidden', open);
      iconClose?.classList.toggle('hidden', !open);
    };

    toggle.addEventListener('click', () => set(panel.hidden));
    panel.querySelectorAll('a[data-close-nav]').forEach((a) =>
      a.addEventListener('click', () => set(false)),
    );
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) {
        set(false);
        toggle.focus();
      }
    });
  })();
</script>
