---
// Castor V3 — Minimal flagship footer (dark obsidian, pairs with the deep-silicon
// act above). Kept lean on purpose: one wordmark line, one row of links, and a
// single quiet legal line. The three SEO subpages keep the richer QuickstartFooter.
import { ARCHITECTURE } from '../data/telemetry';

const GITHUB = ARCHITECTURE.links.github;
const NPM = ARCHITECTURE.links.npm;
const EMAIL = 'm.abdullah.ali.2523@gmail.com';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const LINKS: Array<{ label: string; href: string; props: Record<string, string> }> = [
  { label: 'GitHub', href: GITHUB, props: { target: '_blank', rel: 'noreferrer' } },
  { label: 'npm', href: NPM, props: { target: '_blank', rel: 'noreferrer' } },
  { label: 'Benchmarks', href: `${base}/benchmarks/qwen3-8-27b-rtx-3090/`, props: {} },
  { label: 'Local LLM', href: `${base}/claude-code-local-llm/`, props: {} },
  { label: 'Air-Gap', href: `${base}/enterprise/air-gapped-coding-agent/`, props: {} },
  { label: 'llms.txt', href: `${base}/llms.txt`, props: {} },
  { label: 'Contact', href: `mailto:${EMAIL}`, props: {} },
];
---

<footer class="border-t border-white/10 bg-[#05070B] text-[#8C95A6]">
  <div class="mx-auto flex max-w-6xl flex-col gap-8 px-4 py-12 sm:px-6 md:flex-row md:items-center md:justify-between lg:px-8">
    <div class="flex min-w-0 items-center gap-3">
      <img
        src={`${base}/assets/logo.svg`}
        alt=""
        width="26"
        height="26"
        class="h-[26px] w-[26px]"
        loading="lazy"
        decoding="async"
      />
      <p class="font-display text-sm font-bold tracking-[0.02em] text-[#F5F7FA]">
        CASTOR
      </p>
    </div>

    <nav aria-label="Footer" class="flex flex-wrap gap-x-6 gap-y-2">
      {LINKS.map((l) => (
        <a
          href={l.href}
          {...l.props}
          class="flex min-h-[40px] items-center font-mono text-[12px] text-[#8C95A6] underline decoration-white/10 underline-offset-4 transition-colors hover:text-[#FB923C] hover:decoration-[#FB923C]/40"
        >
          {l.label}
        </a>
      ))}
    </nav>
  </div>
  <div class="border-t border-white/5">
    <p class="mx-auto max-w-6xl px-4 py-4 font-mono text-[10.5px] tracking-[0.05em] text-[#4A5568] sm:px-6 lg:px-8">
      TELEMETRY 2026-11-21 · 2.77B TOKENS · 93.8% KV HIT · $6,034 SAVED
    </p>
    <p class="mx-auto max-w-6xl px-4 pb-4 font-mono text-[10.5px] tracking-[0.05em] text-[#4A5568] sm:px-6 lg:px-8">
      CASTOR · HYBRID &amp; LOCAL GPU INFRASTRUCTURE FOR AI CODING AGENTS ·
      OPEN CORE + TEAM SETUP &amp; PLUMBING
    </p>
  </div>
</footer>
